	"conceptNotes": [
		{
			"id": "b7e2c1a8-3f4d-4a6b-8c9e-1d2f3a4b5c6e",
			"conceptId": "2e0ed87b-a1ae-407e-80a8-c90156d481af",
			"content": "Started learning JWT for the bookmark manager. Confused about the difference between access and refresh tokens. Why two?",
			"createdAt": "2026-01-16T09:10:00.000Z"
		},
		{
			"id": "c8f3d2b9-4e5c-4b7a-9d0f-2e3a4b5c6d7f",
			"conceptId": "2e0ed87b-a1ae-407e-80a8-c90156d481af",
			"content": "Click moment: tokens are stateless, but that means you trade revocation for scalability. Now the refresh+session table pattern makes sense.",
			"createdAt": "2026-02-12T14:10:00.000Z"
		},
		{
			"id": "d9a4e3ca-5f6d-4c8b-ae1f-3f4b5c6d7e80",
			"conceptId": "2e0ed87b-a1ae-407e-80a8-c90156d481af",
			"content": "Finally understand why we hash refresh tokens in the DB but not access tokens. Access tokens never touch storage — the signature IS the verification.",
			"createdAt": "2026-04-15T10:15:00.000Z"
		},
		{
			"id": "ea5b4fdb-6a7e-4d9c-bf20-4a5c6d7e8f91",
			"conceptId": "2e0ed87b-a1ae-407e-80a8-c90156d481af",
			"content": "Implemented full auth for Stride from scratch. Signup, login, refresh, middleware. The whole flow finally feels intuitive.",
			"createdAt": "2026-06-13T09:30:00.000Z"
		},
		{
			"id": "fb6c5aec-7b8f-4eae-c031-5b6d7e8f90a2",
			"conceptId": "4dd37595-1c22-48dc-89a6-5201a4d72ff6",
			"content": "Migrating from useState+useEffect for data fetching. The mental model shift is hard — thinking in queries, not effects.",
			"createdAt": "2026-02-02T14:25:00.000Z"
		},
		{
			"id": "0c7d6bfd-8c9a-4fbf-d142-6c7e8f90a1b3",
			"conceptId": "4dd37595-1c22-48dc-89a6-5201a4d72ff6",
			"content": "Cache invalidation finally clicked. Mutations + queryClient.invalidateQueries is the whole pattern. Optimistic updates next.",
			"createdAt": "2026-06-11T20:10:00.000Z"
		},
		{
			"id": "1d8e7c0e-9dab-40c0-e253-7d8f90a1b2c4",
			"conceptId": "22185dcb-049e-4e4e-b944-c90a2fffaf21",
			"content": "First Prisma schema. Schema design is way harder than I thought. Cascading deletes, foreign keys, when to use @relation — lots of decisions.",
			"createdAt": "2026-03-05T10:30:00.000Z"
		},
		{
			"id": "2e9f8d1f-aebc-41d1-f364-8e90a1b2c3d5",
			"conceptId": "22185dcb-049e-4e4e-b944-c90a2fffaf21",
			"content": "Learned the hard way that stale Prisma Client breaks everything. Always run prisma generate after schema changes.",
			"createdAt": "2026-04-10T11:00:00.000Z"
		},
		{
			"id": "3fa09e20-bfcd-42e2-0475-9f01b2c3d4e6",
			"conceptId": "22185dcb-049e-4e4e-b944-c90a2fffaf21",
			"content": "Nested writes are powerful. Creating a concept + its first rating in one atomic operation feels much cleaner than two sequential creates.",
			"createdAt": "2026-06-12T14:00:00.000Z"
		},
		{
			"id": "40b1af31-c0de-43f3-1586-a012c3d4e5f7",
			"conceptId": "5a148041-ca2c-4cff-929c-b053b31a70b5",
			"content": "Combining with Zod for type-safe forms. The resolver pattern is elegant — one schema, two systems trust it.",
			"createdAt": "2026-04-02T09:40:00.000Z"
		},
		{
			"id": "51c2b042-d1ef-4404-2697-b123d4e5f608",
			"conceptId": "5a148041-ca2c-4cff-929c-b053b31a70b5",
			"content": "Controlled vs uncontrolled inputs in RHF. register() over Controller for native inputs is much less code.",
			"createdAt": "2026-04-20T15:10:00.000Z"
		},
		{
			"id": "62d3c153-e2f0-4515-37a8-c234e5f60719",
			"conceptId": "5a148041-ca2c-4cff-929c-b053b31a70b5",
			"content": "Form-level vs field-level error display. Decided form-level for required fields, inline for validation errors. UX matters more than I thought.",
			"createdAt": "2026-05-15T11:30:00.000Z"
		}
	],
